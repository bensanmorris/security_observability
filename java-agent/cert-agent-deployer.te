module cert_agent_deployer 1.0;

# Minimum permissions for cert-agent-deployer to attach to running JVMs via
# jattach.  The service is pinned to unconfined_service_t via SELinuxContext=
# in the unit file; this policy covers the permissions that remain restricted
# even for that domain on confined RHEL9 systems.
#
# jattach attach sequence:
#   1. Reads /proc/<pid>/exe and /proc/<pid>/cmdline for JVM discovery
#   2. Sends SIGQUIT to the target JVM to wake the attach listener
#   3. Creates /tmp/.attach_pid<N> as a trigger file
#   4. Connects to /tmp/.java_pid<N> UNIX socket created by the JVM
#   5. Loads the agent JAR over that socket

require {
    type unconfined_service_t;
    type unconfined_t;
    type proc_t;
    type tmp_t;
    class process { ptrace signal signull };
    class file { read open getattr create write unlink };
    class dir { read write search open getattr add_name remove_name };
    class lnk_file { read getattr };
    class sock_file { write read getattr };
}

# Custom attribute for "may be ptrace/signaled by cert-agent-deployer to
# perform a JVM attach". Deliberately scoped this way instead of the
# blanket `domain` attribute (which covers every confined type on the
# host -- sshd_t, crond_t, init_t, ...): this daemon already runs as root
# with CAP_SYS_PTRACE/CAP_KILL/CAP_SETUID/CAP_SETGID at the capability
# layer, so `domain`-wide SELinux ptrace/signal on top of that meant a
# compromise of this daemon carried SELinux-authorized reach into every
# other confined service on the host, not just target JVMs -- removing
# SELinux as an independent containment layer for this attack surface.
#
# Only unconfined_t is required here: it's the type most manually-launched
# or otherwise-unlabeled JVM processes actually run as, and (unlike a
# custom java_t) it's guaranteed present in stock RHEL/Fedora targeted
# policy, so requiring it here can't cause `semodule -i` to fail to load
# this whole module on a system that lacks some other, less universal type.
# If a site runs its target JVMs under java_t or another site-specific
# type, extend coverage with a small local module:
#   require { type java_t; }
#   typeattribute java_t cert_agent_jvm_target;
attribute cert_agent_jvm_target;
typeattribute unconfined_t cert_agent_jvm_target;

# ptrace and signal are needed to trigger the JVM attach listener. Target
# is cert_agent_jvm_target (see above), not the full `domain` attribute.
allow unconfined_service_t cert_agent_jvm_target:process { ptrace signal signull };

# /proc/<pid>/ traversal for JVM discovery and attach
allow unconfined_service_t proc_t:file { read open getattr };
allow unconfined_service_t proc_t:dir { read search open getattr };
allow unconfined_service_t proc_t:lnk_file { read getattr };

# jattach creates .attach_pid<N> and connects to .java_pid<N> socket in /tmp
allow unconfined_service_t tmp_t:file { read write create getattr open unlink };
allow unconfined_service_t tmp_t:dir { read write search open getattr add_name remove_name };
allow unconfined_service_t tmp_t:sock_file { write read getattr };
